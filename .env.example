# ── Database (Supabase) ──────────────────────────────────────────────────────
# Get this from: Supabase Dashboard → Project → Settings → Database → URI
# Use the "Transaction" pooler URI (port 5432) for long-lived connections
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── MQTT Broker ──────────────────────────────────────────────────────────────
# When running via docker-compose, set to the service name "mqtt"
# When connecting from external simulator, set to your server IP/domain
MQTT_HOST=mqtt
MQTT_PORT=1883

# ── AI (Anthropic Claude) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your Vercel frontend URL)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# ── Server ───────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
